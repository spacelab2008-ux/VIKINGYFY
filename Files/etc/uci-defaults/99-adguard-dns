#!/bin/sh
# 让 AdGuard Home 接管 53：dnsmasq 让位到 5353，并关闭 fw4 自带的 DNS 重定向
# 否则 dnsmasq 占着 53，AGH 启动会失败（bind: address in use）
# 幂等：重复执行只写入相同值，安全

[ -x /usr/bin/AdGuardHome ] || exit 0

uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1 || exit 0

uci set dhcp.@dnsmasq[0].port='5353'
uci set dhcp.@dnsmasq[0].dns_redirect='0'
uci commit dhcp

/etc/init.d/dnsmasq restart >/dev/null 2>&1

exit 0

#!/bin/sh
# 让 AdGuard Home 接管 53，并阻止 OpenClash 抢回 DNS
#
# 背景（两次刷机都踩到的坑）：
#   1) dnsmasq 默认占 53，AGH 起来会 bind 失败 → 必须让 dnsmasq 退到 5353
#   2) OpenClash 的 enable_redirect_dns 默认为 1，它会生成
#      "redirect to :5353" 的 DNS Hijack 规则，把内网 DNS 直接送到 dnsmasq，
#      完全绕过 AGH —— 表现为 AGH 面板查询量极低、规则看似失效
#      必须关掉它，改由 /etc/nftables.d/20-dns-hijack.nft 统一劫持回 :53
#
# 命名用 zz- 前缀：uci-defaults 按文件名排序执行，OpenClash 自带的是
# luci-app-openclash（字母开头），数字前缀会排在它之前从而被覆盖。
#
# 幂等：重复执行只写入相同值，安全

[ -x /usr/bin/AdGuardHome ] || exit 0

# 1. dnsmasq 让出 53
if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
	uci set dhcp.@dnsmasq[0].port='5353'
	uci set dhcp.@dnsmasq[0].dns_redirect='0'
	uci commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
fi

# 2. 关掉 OpenClash 的 DNS 劫持（配置不存在则跳过，避免留下半截 uci 节点）
if [ -f /etc/config/openclash ]; then
	uci set openclash.config.enable_redirect_dns='0'
	uci set openclash.config.redirect_dns='0'
	uci commit openclash
fi

exit 0
